# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMTP — UCLA uses Microsoft 365, so these defaults should work as-is.
# Use your UCLA email credentials (or create a shared mailbox like msba@anderson.ucla.edu).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=msba@ucla.edu
SMTP_PASS=your-password-or-app-password

# The display name + address shown in the From field of every email
SMTP_FROM=MSBA Admissions <msba@ucla.edu>

# The public URL of your deployed app (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
